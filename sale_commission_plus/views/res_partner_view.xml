<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_agent" model="ir.ui.view">
        <field name="name">res.partner.form.agent</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale_commission.view_partner_form_agent" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='agent_information']//field[@name='commission']"
                   position="after">
                <field name="head_agent"/>
                <field name="head_commission"
                       attrs="{'required': [('head_agent', '=', True)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
